# Klipper firmware configuration shared by Lerdge-K and Lerdge-X boards
# (STM32F407ZGT6, 25 MHz crystal, stock 64KiB Lerdge bootloader, host on
# USART1 PA10/PA9 - the board's USB port goes through a USB-serial chip
# to the same USART).  @BAUD@ and @FALLBACK@ are filled in by install.sh.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F407=y
CONFIG_STM32_FLASH_START_10000=y
CONFIG_STM32_LERDGE_RAM_RESERVE=y
CONFIG_STM32_CLOCK_REF_25M=y
CONFIG_STM32_SERIAL_USART1=y
CONFIG_SERIAL_BAUD=@BAUD@
CONFIG_SERIAL_BAUD_FALLBACK=@FALLBACK@
CONFIG_WANT_TFT_FSMC=y
