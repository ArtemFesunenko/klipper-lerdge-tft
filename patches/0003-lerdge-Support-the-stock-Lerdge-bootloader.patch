new file mode 100644
index 000000000..cdf939ff4
--- /dev/null
+++ b/scripts/lerdge_bootflag.py
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+# Request a firmware update from the stock Lerdge-K bootloader
+#
+# The Lerdge-K bootloader (V1.0.4) keeps a flag byte at offset 0x500000 of
+# the board's external SPI flash (SPI1 on PA5/PA6/PA7, CS on PC4).  When the
+# byte is 0xAA the bootloader starts the application without looking for a
+# firmware update on the TF card.  This tool clears the byte (a NOR flash
+# program operation that only clears bits, so no erase is needed) and
+# resets the micro-controller so that the bootloader installs
+# "Lerdge_K_system/Firmware/Lerdge_K_firmware_force.bin" from the TF card.
+# The bootloader sets the flag back to 0xAA after checking for updates.
+#
+# Klipper must be stopped while this tool runs.
+#
+# Copyright (C) 2026  Klipper Lerdge TFT contributors
+#
+# This file may be distributed under the terms of the GNU GPLv3 license.
+import sys, os, argparse
+KLIPPER_DIR = os.path.abspath(os.path.join(os.path.dirname(__file__), "../"))
+sys.path.append(os.path.join(KLIPPER_DIR, "klippy"))
+import reactor, serialhdl
+
+FLAG_ADDR = 0x500000
+RECORD_SIZE = 0x21
+FLAG_OK = 0xAA
+
+class LerdgeBootFlag:
+    def __init__(self, args):
+        self.args = args
+        self.reactor = reactor.Reactor()
+        self.ser = None
+    def out(self, msg):
+        sys.stdout.write(msg + "\n")
+        sys.stdout.flush()
+    def connect(self):
+        if self.ser is not None:
+            self.ser.disconnect()
+        self.ser = serialhdl.SerialReader(self.reactor)
+        self.ser.connect_uart(self.args.device, self.args.baud)
+    def get_config(self):
+        return self.ser.send_with_response("get_config", "config")
+    def reset(self):
+        self.ser.send("reset")
+        self.reactor.pause(self.reactor.monotonic() + 0.015)
+    def xfer(self, data):
+        cmd = "spi_transfer oid=0 data=%s" % (
+            "".join(["%02x" % (b,) for b in data]),)
+        msg = self.ser.get_msgparser().create_command(cmd)
+        src = serialhdl.SerialRetryCommand(self.ser, "spi_transfer_response",
+                                           0)
+        params = src.get_response([msg],
+                                  self.ser.get_default_command_queue())
+        return bytearray(params['response'])
+    def setup_spi(self):
+        cfg = self.get_config()
+        if cfg['is_config'] or cfg['is_shutdown']:
+            raise Exception("MCU is already configured - stop Klipper and"
+                            " reset the MCU first")
+        self.ser.send("allocate_oids count=1")
+        self.ser.send("config_spi oid=0 pin=PC4 cs_active_high=0")
+        self.ser.send("spi_set_bus oid=0 spi_bus=spi1 mode=0 rate=1000000")
+        self.ser.send("finalize_config crc=0")
+        cfg = self.get_config()
+        if not cfg['is_config'] or cfg['is_shutdown']:
+            raise Exception("MCU configuration failed: %s" % (cfg,))
+    def read(self, addr, count):
+        resp = self.xfer([0x03, (addr >> 16) & 0xff, (addr >> 8) & 0xff,
+                          addr & 0xff] + [0] * count)
+        return resp[4:]
+    def wait_ready(self):
+        for i in range(100):
+            if not self.xfer([0x05, 0])[1] & 0x01:
+                return
+            self.reactor.pause(self.reactor.monotonic() + 0.005)
+        raise Exception("SPI flash busy timeout")
+    def run_task(self, eventtime):
+        try:
+            self.connect()
+            if self.get_config()['is_config']:
+                self.out("MCU is configured, resetting it first...")
+                self.reset()
+                self.reactor.pause(self.reactor.monotonic() + 3.)
+                self.connect()
+            self.setup_spi()
+            jedec = self.xfer([0x9f, 0, 0, 0])[1:]
+            self.out("SPI flash JEDEC id: %s" % (jedec.hex(),))
+            if jedec in (b'\x00\x00\x00', b'\xff\xff\xff'):
+                raise Exception("No SPI flash found")
+            record = self.read(FLAG_ADDR, RECORD_SIZE)
+            self.out("Record at 0x%x: %s" % (FLAG_ADDR, record.hex()))
+            if self.args.clear:
+                if record[0] != FLAG_OK:
+                    self.out("Flag is 0x%02x (not 0x%02x), leaving it"
+                             % (record[0], FLAG_OK))
+                else:
+                    self.xfer([0x06])
+                    self.xfer([0x02, (FLAG_ADDR >> 16) & 0xff,
+                               (FLAG_ADDR >> 8) & 0xff, FLAG_ADDR & 0xff,
+                               0x00])
+                    self.wait_ready()
+                    record = self.read(FLAG_ADDR, RECORD_SIZE)
+                    self.out("Record after clear: %s" % (record.hex(),))
+                    if record[0] != 0x00:
+                        raise Exception("Failed to clear the flag")
+                if self.args.reset:
+                    self.out("Resetting MCU into the bootloader...")
+                    self.reset()
+            self.result = 0
+        except Exception as e:
+            self.out("ERROR: %s" % (e,))
+            self.result = 1
+        self.reactor.end()
+    def run(self):
+        self.result = 1
+        self.reactor.register_callback(self.run_task)
+        try:
+            self.reactor.run()
+        finally:
+            if self.ser is not None:
+                self.ser.disconnect()
+            self.reactor.finalize()
+        return self.result
+
+def main():
+    p = argparse.ArgumentParser(description="Lerdge-K bootloader update flag")
+    p.add_argument("-b", "--baud", type=int, default=250000)
+    p.add_argument("--clear", action="store_true",
+                   help="clear the 'no update' flag (0xAA)")
+    p.add_argument("--reset", action="store_true",
+                   help="reset the MCU after clearing the flag")
+    p.add_argument("device")
+    args = p.parse_args()
+    sys.exit(LerdgeBootFlag(args).run())
+
+if __name__ == '__main__':
+    main()
