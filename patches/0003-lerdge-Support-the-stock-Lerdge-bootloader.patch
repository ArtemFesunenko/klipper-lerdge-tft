diff --git a/scripts/update_lerdge.py b/scripts/update_lerdge.py
new file mode 100644
index 000000000..865d2c8ce
--- /dev/null
+++ b/scripts/update_lerdge.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+# Encrypt a Klipper binary for the stock Lerdge bootloader
+#
+# The Lerdge bootloader (64KiB, application at 0x08010000) installs
+# "Lerdge_X_system/Firmware/Lerdge_X_firmware_force.bin" from the root of
+# the TF card at power on.  The file is a byte-wise scrambled image.
+#
+# Copyright (C) 2026  Klipper Lerdge TFT contributors
+#
+# This file may be distributed under the terms of the GNU GPLv3 license.
+import sys, os, argparse
+
+def encrypt_byte(b):
+    b = 0xff & ((b << 6) | (b >> 2))
+    i = 0x58 + b
+    j = 0x05 + b + (i >> 8)
+    return (0xf8 & i) | (0x07 & j)
+
+ENCRYPT = bytearray([encrypt_byte(b) for b in range(256)])
+DECRYPT = bytearray(256)
+for _plain, _enc in enumerate(ENCRYPT):
+    DECRYPT[_enc] = _plain
+
+BOARDS = {'k': 'K', 'x': 'X', 's': 'S'}
+
+def main():
+    p = argparse.ArgumentParser(
+        description="Create a Lerdge bootloader firmware file")
+    p.add_argument("input", help="klipper.bin (built with 64KiB bootloader)")
+    p.add_argument("output", nargs="?", default=None,
+                   help="output file or directory (default: create"
+                   " Lerdge_<board>_system/Firmware/... in the current dir)")
+    p.add_argument("-b", "--board", default="k", choices=sorted(BOARDS),
+                   help="Lerdge board type (default: k)")
+    p.add_argument("-d", "--decrypt", action="store_true",
+                   help="decrypt instead of encrypt")
+    args = p.parse_args()
+    data = bytearray(open(args.input, 'rb').read())
+    table = DECRYPT if args.decrypt else ENCRYPT
+    out = bytearray(table[b] for b in data)
+    board = BOARDS[args.board]
+    output = args.output
+    if output is None or os.path.isdir(output):
+        base = output or "."
+        folder = os.path.join(base, "Lerdge_%s_system" % (board,), "Firmware")
+        if not os.path.isdir(folder):
+            os.makedirs(folder)
+        output = os.path.join(folder, "Lerdge_%s_firmware_force.bin"
+                              % (board,))
+    with open(output, 'wb') as f:
+        f.write(out)
+    sys.stdout.write("Wrote %d bytes to %s\n" % (len(out), output))
+
+if __name__ == '__main__':
+    main()
