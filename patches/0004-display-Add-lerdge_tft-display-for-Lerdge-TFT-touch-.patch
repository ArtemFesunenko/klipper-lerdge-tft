+[display_data _lerdge_16x6 flow]
+position: 4, 0
+text:
+  { "Flow %-4.0f" % (printer.gcode_move.extrude_factor * 100,) }
+  {% if 'print_stats' in printer %}
+    {% set info = printer.print_stats.info %}
+    {% if info and info.current_layer %}
+      { "L%d" % (info.current_layer,) }
+    {% endif %}
+  {% endif %}
+
+[display_data _lerdge_16x6 print_status]
+position: 5, 0
+text:
+  {% set state = printer.print_stats.state if 'print_stats' in printer
